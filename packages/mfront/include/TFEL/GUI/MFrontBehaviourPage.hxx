/*!
 * \file   MFrontBehaviourPage.hxx
 * \brief wizard page selecting the DSL and parameters of the behaviour.
 * \author Thomas Helfer
 * \date   27/07/2019
 */

#ifndef LIB_TFEL_GUI_MFRONTBEHAVIOURPAGE_HXX
#define LIB_TFEL_GUI_MFRONTBEHAVIOURPAGE_HXX

#include <memory>
#include <QtWidgets/QWizard>
#include "MFront/BehaviourDescription.hxx"
#include "MFront/BehaviourDSLDescription.hxx"

// forward declaration
class QLabel;
class QComboBox;
class QTextDocument;
class QTextCursor;

namespace mfront {

  // forward declaration
  struct AbstractBehaviourDSL;

}  // end of namespace mfront

namespace tfel::gui {

  // forward declarations
  struct EditorWidget;
  struct TextEditBase;
  struct LineEdit;
  struct MFrontBehaviourWizard;

  /*!
   * \brief a wizard page used to select the domain specific language of the
   * behaviour, its main characteristics and its numerical parameters
   *
   * The combo boxes of the page are interdependent: the behaviour type selects
   * the integration schemes, which select the DSLs, which select the bricks,
   * and the DSL description then filters the modelling hypotheses, symmetries,
   * strain measures, elastic properties, crystal structures and tangent
   * operators which are proposed. A choice which is unavailable is not hidden
   * but greyed out, its label being marked as disabled.
   *
   * \note all the widgets are created by the constructor and are reparented to
   * the page by its layout, so the page owns them
   */
  struct MFrontBehaviourPage : public QWizardPage {
    //! \brief a simple alias
    using BehaviourDescription = mfront::BehaviourDescription;
    //! \brief options for the generation of the DSL
    struct DSLGenerationOptions {
      /*!
       * \brief if this member is false, the `@Brick` declaration of the brick
       * selected by the user is not written. The wizard uses this to create a
       * first DSL object without the brick, which is the state the brick
       * factory needs to be given a behaviour description.
       */
      bool with_brick = true;
    };  // end of DSLGenerationOptions
    /*!
     * \brief constructor
     * \param[in] w: editor widget, used by the line edits of the page and to
     * report failures in the minibuffer
     * \param[in] cd: current document, which the generated text is written in
     * \param[in] p: parent, that is the wizard the page belongs to
     *
     * \note the constructor fills the combo boxes and connects them so that
     * changing one of them refreshes those which depend on it
     *
     * \note the three numerical parameters are constrained by double
     * validators: the convergence criterion and the perturbation value must not
     * be negative, the implicit parameter must stay in `[0, 1]`
     */
    MFrontBehaviourPage(EditorWidget &,
                        TextEditBase &,
                        MFrontBehaviourWizard *const);

    /*!
     * \brief check that the selections made in the page are consistent
     *
     * A minimal MFront file is built from the current selections, completed
     * with the minimal body the DSL requires, and handed over to MFront for
     * analysis.
     *
     * \return false, after a message box explains the reason, when MFront
     * rejects that file; the user is then kept on the page
     *
     * \note true is returned, and the user may go on, when the temporary file
     * can not be opened or written, or when the selected DSL is not a behaviour
     * DSL; the reason is only displayed in the minibuffer
     */
    bool validatePage() override;

    /*!
     * \return the identifier of the page which follows this one: the page of
     * the standard elasto-visco-plasticity brick when that brick is selected,
     * the page which adds variables otherwise
     */
    int nextId() const override;
    /*!
     * \brief write the output of the wizard at the cursor of the document, in
     * the final stage, with the default generation options
     *
     * \note the editor's cursor is left at the end of the inserted text
     */
    virtual void write() const;
    /*!
     * \return the abstract behaviour dsl generated by the behaviour page.
     *
     * The current selections are written to a temporary file as a partial
     * MFront file, in the processing stage, which a DSL created for the
     * selected language then reads.
     *
     * \note a null pointer is returned when the temporary file can not be
     * opened or written, when the selections are inconsistent, or when the
     * selected DSL is not a behaviour DSL. The reason is displayed in the
     * minibuffer or in a message box, so callers must check the result before
     * using it
     */
    virtual std::shared_ptr<mfront::AbstractBehaviourDSL> getBehaviourDSL(
        const DSLGenerationOptions &) const;
    /*!
     * \return the selected DSL, that is the name under which the DSL is
     * registered in \c mfront::DSLFactory; the empty string when the list of
     * DSLs compatible with the behaviour type and the integration scheme is
     * empty
     */
    virtual QString getSelectedDomainSpecificLanguage() const;
    /*!
     * \return the selected tangent operator, one of the names of the finite
     * strain tangent operators; the combo box is disabled for the other
     * behaviour types and its text is the empty string then
     */
    virtual QString getSelectedTangentOperator() const;
    /*!
     * \return the selected brick, as it is named by
     * \c mfront::BehaviourBrickFactory
     *
     * \note the empty string is returned when no brick is available or when the
     * user has kept the "None" entry
     */
    virtual QString getSelectedBrick() const;
    /*!
     * \brief destructor
     *
     * The widgets of the page are children of the page and are released by Qt
     */
    ~MFrontBehaviourPage() override;

   protected:
    //! \brief This enum lists various options passed to the `write` method
    enum WriteMode {
      FINAL_STAGE,      //!< \brief generate the final version of the wizard
      VALIDATE_STAGE,   /*!<
                         * \brief generate a fully working example to
                         * see
                         * if all the options selected are consistent
                         */
      PROCESSING_STAGE, /*!
                         * \brief generate a partial document used to
                         * build a behaviour description where
                         * material properties, parameters, etc.. can
                         * be added
                         */
    };                  // end of enum WriteMode
    /*!
     * \return the selected behaviour type, translated from the text of the
     * combo box; a generic behaviour is returned for any other entry
     */
    BehaviourDescription::BehaviourType getSelectedBehaviourType() const;
    /*!
     * \return the selected integration scheme, translated from the text of the
     * combo box; the user defined scheme is returned for any other entry, the
     * combo box being empty when no scheme is available
     */
    BehaviourDescription::IntegrationScheme getSelectedIntegrationScheme()
        const;
    /*!
     * \brief update the list of integration schemes according to the
     * selected behaviour type.
     *
     * Only the schemes of the registered behaviour DSLs which implement that
     * type are listed. The implicit scheme is preselected for the standard
     * strain based and finite strain behaviours and for generic behaviours
     * when it is available.
     *
     * \note this updates the lists of DSLs, bricks and algorithms as well
     */
    void updateIntegrationSchemeList();
    /*!
     * \brief update the list of DSLs registered for the selected behaviour type
     * and integration scheme
     *
     * \note this updates the lists of bricks and strain measures as well
     */
    void updateDSLList();
    /*!
     * \brief update the list of modelling hypotheses supported by the selected
     * DSL, with a "Default" entry when more than one is supported and an "All"
     * entry when all of them are
     *
     * \note this updates the list of elastic properties as well
     */
    void updateModellingHypothesisList();
    /*!
     * \brief update the list of behaviour symmetries the selected DSL supports:
     * isotropic and, for an orthotropic DSL, the three orthotropic entries
     * unless the DSL only supports the tridimensional hypothesis
     *
     * The combo box is disabled when a single symmetry is available, as the
     * user has then nothing to choose.
     */
    void updateBehaviourSymmetryList();
    /*!
     * \brief update the list of crystal structures, with a "None" entry unless
     * the selected DSL requires such a definition
     *
     * The combo box is disabled when the DSL does not allow a crystal structure
     * to be defined.
     */
    void updateCrystalStructureList();
    /*!
     * \brief update the list of algorithms: the non linear system solvers
     * registered by MFront for the implicit scheme, the Runge-Kutta schemes for
     * the explicit scheme, nothing otherwise, in which case the combo box is
     * disabled
     *
     * The Newton-Raphson solver is preselected for the implicit scheme.
     *
     * \note this updates the numerical criteria as well
     */
    void updateAlgorithmList();
    /*!
     * \brief update the list of strain measures (Hencky, Green-Lagrange,
     * linearized), only available for a standard strain based behaviour
     */
    void updateStrainMeasureList();
    /*!
     * \brief update the list of the bricks which can be used with the selected
     * behaviour type and integration scheme, with a "None" entry first
     *
     * The combo box is disabled when no brick is registered for that pair.
     *
     * \note this updates the lists of modelling hypotheses, symmetries, crystal
     * structures and elastic properties as well
     */
    void updateBrickList();
    /*!
     * \brief update the list of the ways the elastic properties can be defined
     * by the selected DSL: stiffness tensor computations or requirements, with
     * the altered or unaltered variant for the plane stress like hypotheses,
     * \c @ElasticMaterialProperties, or "Undefined"
     *
     * The list is empty for a cohesive zone model or a generic behaviour.
     */
    void updateElasticPropertyList();
    /*!
     * \brief update the list of tangent operators of the finite strain
     * behaviours
     *
     * The combo box is disabled for the other behaviour types.
     */
    void updateTangentOperatorList();
    /*!
     * \brief enable or disable the numerical criteria according to the selected
     * integration scheme and algorithm
     *
     * The convergence criterion and the implicit parameter are only available
     * for the implicit, explicit and specialized schemes; the perturbation
     * value is only available for the implicit scheme when the selected solver
     * uses a jacobian it has to compute numerically.
     */
    void updateNumericalCriteria();
    /*!
     * \brief write the output of the wizard
     * \param[in] tc: text cursor the text is inserted at
     * \param[in] o: generation options
     * \param[in] m: stage of the generation, which selects how much of the
     * document is written: in the validation stage the elastic properties are
     * given dummy values so that the file can be analysed, and are commented
     * out in the other stages, for the user to fill them in; the standard
     * elasto-visco-plasticity brick gets a minimal valid declaration in the
     * validation and processing stages; the options of the brick are only
     * written in the final stage
     */
    virtual void write(QTextCursor,
                       const DSLGenerationOptions &,
                       const WriteMode) const;
    /*!
     * \return the description of the currently selected DSL, completed with the
     * description of the selected brick, as the brick may restrict or extend
     * what the DSL supports
     *
     * \note a default constructed description is returned when the DSL can not
     * be created, when it is not a behaviour DSL, or when the brick can not be
     * built; no diagnostic is reported in those cases
     */
    virtual mfront::BehaviourDSLDescription getCurrentBehaviourDSLDescription()
        const;
    //! \brief combox box associated with behaviour type
    QComboBox *bts = nullptr;
    //! \brief combox box associated with integration scheme
    QComboBox *iss = nullptr;
    //! \brief combox box showing available DSLs
    QComboBox *dsls = nullptr;
    //! \brief labBel associated with algorithms
    QLabel *algorithms_label = nullptr;
    //! \brief combox box showing available algorithms
    QComboBox *algorithms = nullptr;
    //! \brief label associated with material hypotheses
    QLabel *hypotheses_label = nullptr;
    //! \brief combox box showing available hypotheses
    QComboBox *hypotheses = nullptr;
    //! \brief label associated with material symmetries
    QLabel *symmetries_label = nullptr;
    //! \brief combox box showing available symmetries
    QComboBox *symmetries = nullptr;
    //! \brief label associated with strain measures
    QLabel *strain_measures_label = nullptr;
    //! \brief combox box showing available strain measures
    QComboBox *strain_measures = nullptr;
    //! \brief label associated with bricks
    QLabel *bricks_label = nullptr;
    //! \brief combox box showing available bricks
    QComboBox *bricks = nullptr;
    //! \brief label associated with elastic properties
    QLabel *elastic_properties_label = nullptr;
    //! \brief combox box showing available elastic properties
    QComboBox *elastic_properties = nullptr;
    //! \brief label associated with crystal structure
    QLabel *crystal_structures_label = nullptr;
    //! \brief combox box showing available crystal structures
    QComboBox *crystal_structures = nullptr;
    //! \brief label associated with tangent operators
    QLabel *tangent_operators_label = nullptr;
    //! \brief combox box showing available tangent operators
    QComboBox *tangent_operators = nullptr;
    //! \brief label associated with the convergence criterion
    QLabel *convergence_criterion_label = nullptr;
    //! \brief editing line for convergence criterion
    LineEdit *convergence_criterion = nullptr;
    //! \brief label associated with the implicit parameter
    QLabel *implicit_parameter_label = nullptr;
    //! \brief editing line for implicit parameter
    LineEdit *implicit_parameter = nullptr;
    //! \brief label associated with the perturbation value
    QLabel *perturbation_value_label = nullptr;
    //! \brief editing line for the perturbation value
    LineEdit *perturbation_value = nullptr;
    //!\brief underlying editor
    EditorWidget &editor;
    //!\brief document
    TextEditBase &d;

   private:
    Q_OBJECT
  };  // end of struct MFrontBehaviourPage

}  // end of namespace tfel::gui

#endif /* LIB_TFEL_GUI_MFRONTBEHAVIOURPAGE_HXX */
